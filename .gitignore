.env
# Любая копия .env — ключи те же самые. Реальный случай 14.09: `cp .env .env.bak`
# перед `--create-template` (lumean_tts.persist_env_value переписывает файл
# целиком) оставил untracked файл с живыми ключами, который правило `.env` не
# покрывало. Один символ разницы в имени — и ключи коммитятся.
.env.*
!.env.example
secrets/
*.key
videos/
*.mp3
*.mp4
*.wav
media/
# Статические ассеты (не сгенерированные эпизоды) — исключение из *.mp4/*.mp3 выше.
!assets/**/*.mp4
!assets/**/*.mp3
.venv/
__pycache__/
*.pyc
.setup_complete

# Источники атмосферного слоя (assets/ambience/) — 68 МБ и НЕ хранятся в git.
# Причина: они воспроизводятся одной командой и детерминированно
# (`python scripts/generate_ambience.py`, фиксированные seed, никакого
# hash()), то есть это не исходник, а продукт. Плюс их наличие на диске —
# ЭТО и есть выключатель слоя (см. ambience_layers() в pipeline_smart.py):
# сначала `--preview 20` и послушать, потом запустить без флага и тем самым
# включить. Хранение в репозитории обнулило бы этот порядок.
# Пакет точечных эффектов (assets/sfx/) весит 72 КБ и лежит в git как есть.
assets/ambience/

# Кэш скачанных кандидатов библиотеки звуков (temp_library/) — продукт, не исходник.
temp_library/

# Записи атмосферы из библиотеки (сотни МБ) не хранятся в git — восстанавливаются
# по манифесту: python scripts/sound_library.py restore. Эффекты (sfx/) и манифест — в git.
assets/library/ambience/

# Кэш рендера. Обычно живёт внутри videos/<эпизод>/temp_smart (а videos/ уже
# игнорируется), но скрипт, запущенный из корня репозитория, создаёт его
# здесь — и тогда сотни .npy с эмбеддингами попадают в untracked. Это
# продукт, а не исходник: пересчитывается сам.
temp_smart/

# Кэш эмбеддингов моделей отбора — ОБЩИЙ на репозиторий (раньше жил внутри
# temp_smart эпизода и умирал вместе с ним). Ключи — md5 содержимого файла и
# подпись модели, поэтому эпизоды делят его безопасно. Продукт, не исходник.
temp_emb_cache/

# Записи объектного слоя (предметные звуки) ХРАНЯТСЯ В GIT — 2.8 МБ на всю
# папку (замер 14.09), это порядок пакета эффектов (assets/sfx/, 72 КБ), а не
# атмосферы (assets/library/ambience/, 639 МБ). Прежняя оценка «сотни МБ»
# была неверна, и цена ошибки реальная: у локальных пакетов (Sonniss, см.
# scripts/sonniss_ingest.py) в манифесте НЕТ URL, поэтому `restore` их не
# восстановит никогда — исключённые из git, они исчезали с контейнером.

# Дисковый кэш музейного поиска (temp_museum_cache/) — продукт, не исходник:
# восстанавливается сам при следующем прогоне (см. museum_sources.search_museums).
temp_museum_cache/

# Дисковый кэш поиска Openverse — тот же принцип, что temp_museum_cache/.
temp_openverse_cache/

# Локальный каталог Мет: дамп 303 МБ + индекс. ПРОДУКТ, а не исходник —
# пересобирается 'python scripts/met_catalog.py build'.
temp_met_catalog/

# Визуальная полка: матрица эмбеддингов + скачанные превью. ПРОДУКТ —
# пересобирается 'python scripts/shelf_index.py build'.
temp_shelf_index/

# Заморозки харнесса эквивалентности отбора (scripts/selection_freeze.py):
# записанная сеть — картинки и видео-трайлы, сотни МБ на эпизод. Продукт
# прогона, а не исходник: перезаписывается командой record.
temp_selection_freeze/

# Веса локального режиссёра (2.3-12.4 ГБ). ПРОДУКТ, а не исходник:
# ставится 'python scripts/setup_local_director.py'. Правило по РАСШИРЕНИЮ,
# а не по одной папке: файл весов, положенный мимо models/, — это те же
# гигабайты в истории git, и удаление одного файла чинит один случай,
# правило — весь класс (тот же урок, что с .env.bak).
models/
*.gguf
