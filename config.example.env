# Скопируйте в .env и впишите свои ключи. .env в git не попадает.

# --- Картинки: модель шлюза (цены: python scripts/list_models.py image) ---
# Облик — картинки в look/ (look/README.md); другая папка — LOOK_DIR.
IMAGE_MODEL=ag/gemini-3.1-flash-image
# Gemini через шлюз шире 3:2 не рисует (1792x1024 — отказ провайдера); поля до 16:9 добавляет сборка
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=low
# Потолок расходов на картинки за прогон (обязателен для платной модели)
IMAGE_MAX_SPEND=
# Картинка на фразу одна; второй раунд (платный) — только если первая вышла браком
# или под подписи не нашлось места
IMAGE_VARIANTS=1
IMAGE_ROUNDS=2
IMAGE_WORKERS=3
# Цвет стрелок на схемах (пусто — как в образцах стиля)
DIAGRAM_ARROW_COLOR=red
# Фон: схемы и подписи — всегда лист этого цвета, сцены — если у них нет конкретного места; пусто — как в образцах стиля
DIAGRAM_BACKGROUND=near-white
# Герой: доля кадров с ним и максимум подряд (гость — 0.35; маскот-лицо канала — от 0.5).
# Кот канала — маскот на большинстве кадров (решение владельца 04.10, разбор критика: «кот есть и действует»)
HERO_MAX_SHARE=0.8
HERO_MAX_RUN=6

# --- Шлюз моделей: планировщик, судья, чтение подписей ---
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://anymodel.org/v1
PLANNER_MODEL=ds/deepseek-v4-flash
PLANNER_MAX_SPEND=200000
SHOT_JUDGE=1
SHOT_JUDGE_MODEL=qwen/qwen3.7-plus
SHOT_JUDGE_MAX_SPEND=300000

# --- Озвучка (Lumean, основной путь; иначе положите audio.mp3 сами) ---
LUMEAN_API_KEY=
LUMEAN_TEMPLATE_ID=

# --- Рендер ---
# RENDER_WORKERS=3
# Музыка: положите дорожку в assets/music/ — уровень выставится по замеру.
