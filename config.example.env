# Скопируй в .env и впиши СВОИ ключи. .env не коммитить.
# --- Озвучка (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# --- Сток (бесплатные ключи) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_API_KEY=
# --- AI-картинки (опц.) ---
FASTGEN_API_KEY=
# Grok Imagine / Google Flow — через сессию браузера, ключ не нужен
# --- Анализ (опц.) ---
GEMINI_API_KEY=
# NexLev / vidIQ — MCP-коннекторы (OAuth), не .env
# --- Reference-Guided Look Management (опц., см. scripts/look_reference.py) ---
# CHANNEL_ID — метаданные для аудита lookbook (защита от случайного copy-paste
# assets/lookbook/lookbook.json между репозиториями разных каналов), не
# обязательно. Дефолт "default", если не задано.
CHANNEL_ID=
# off (дефолт) / shadow (считает и пишет отчёт, рендер не трогает) / assist
# (реально применяет). Пока lookbook.json пуст — не влияет ни при каком режиме.
LOOK_MANAGEMENT_MODE=off
# --- Semantic Visual Director (опц., см. scripts/visual_director.py) ---
# off (дефолт, ноль влияния на рендер) / shadow (считает extra_score и пишет
# media_plan/visual_director_report.json, реальный выбор кадра не трогает) /
# assist (реально влияет на выбор). shadow/assist расширяют пул скачиваемых
# кандидатов в pexels_photo() (DIRECTOR_MIN_POOL) — реальная доп. нагрузка на
# квоту Pexels (ЧАСТЬ 21: 200/час, 20000/мес), не только на локальный CLIP.
VISUAL_DIRECTOR_MODE=off
