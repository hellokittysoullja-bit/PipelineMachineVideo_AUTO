# Скопируй в .env и впиши СВОИ ключи. .env не коммитить.
# --- Озвучка (ElevenLabs) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# --- Сток (бесплатные ключи) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_API_KEY=
# Openverse (см. scripts/stock_fetch_multisource.py) — ключ НЕ нужен, публичный
# API. off (дефолт) / 1 — включает поиск по Openverse (агрегирует Wikimedia
# Commons и др.) ТОЛЬКО license=cc0 (без обязательной атрибуции — by/by-sa
# сознательно не включены, пайплайн сегодня не умеет вставлять атрибуции в
# описание YouTube; pdm тоже сознательно исключена — это самоидентификация
# "кто-то решил, что работа свободна", не юридический отказ от прав, как у
# cc0) И ТОЛЬКО из проверенных институциональных источников (Wikimedia,
# Смитсоновский институт, музеи/архивы — не персональные/самотегируемые
# платформы). Для исторических карт/архивных изображений — контента,
# которого физически нет у Pexels/Pixabay/Unsplash (фотосток современных сцен).
OPENVERSE_ENABLED=0
# --- Lumean (TTS/SFX/музыка через систему заказов, см. Lumean Public API) ---
# X-API-KEY публичного контура api.lumean.app (личный кабинет -> API-ключи).
# Голос ПРИВЯЗЫВАЕТСЯ К ШАБЛОНУ (POST /templates -> config.tts_settings.voice_id),
# не передаётся полем заказа напрямую — orders.voice_id не существует. Текст TTS
# идёт в top-level input_text заказа, НЕ в task_data (там — параметры SFX/music).
LUMEAN_API_KEY=
# UUID шаблона (создаётся один раз через POST /templates, дальше переиспользуется
# на каждый заказ). Пусто, пока шаблон не создан.
LUMEAN_TEMPLATE_ID=

# --- AI-картинки (опц.) ---
FASTGEN_API_KEY=
# Grok Imagine / Google Flow — через сессию браузера, ключ не нужен
# --- Анализ (опц.) ---
GEMINI_API_KEY=
# NexLev / vidIQ — MCP-коннекторы (OAuth), не .env
# --- Reference-Guided Look Management (опц., см. scripts/look_reference.py) ---
# CHANNEL_ID — метаданные для аудита lookbook (защита от случайного copy-paste
# assets/lookbook/lookbook.json между репозиториями разных каналов), не
# обязательно. Дефолт "default", если не задано.
CHANNEL_ID=
# off (дефолт) / shadow (считает и пишет отчёт, рендер не трогает) / assist
# (реально применяет). Пока lookbook.json пуст — не влияет ни при каком режиме.
LOOK_MANAGEMENT_MODE=off
# --- Semantic Visual Director (опц., см. scripts/visual_director.py) ---
# off (дефолт, ноль влияния на рендер) / shadow (считает extra_score и пишет
# media_plan/visual_director_report.json, реальный выбор кадра не трогает) /
# assist (реально влияет на выбор). shadow/assist расширяют пул скачиваемых
# кандидатов в pexels_photo() (DIRECTOR_MIN_POOL) — реальная доп. нагрузка на
# квоту Pexels (ЧАСТЬ 21: 200/час, 20000/мес), не только на локальный CLIP.
VISUAL_DIRECTOR_MODE=off
# --- LLM-режиссёр (опц., см. scripts/shot_director.py) ---
# off (дефолт, ноль вызовов) / on (заполняет ТОЛЬКО блоки без авторского
# запроса И без совпадения в themes.json — идиомы/метафоры, реальный,
# эмпирически найденный пробел, см. CLAUDE.md ЧАСТЬ 14). Использует уже
# существующий GEMINI_API_KEY выше, новый ключ не нужен. Перед первым
# включением — обязателен один живой ручной прогон на реальном ключе
# (в этой сборке ещё не подтверждён, см. докстринг shot_director.py).
SHOT_DIRECTOR_MODE=off
SHOT_DIRECTOR_MAX_CALLS_PER_RUN=15
# --- VLM-арбитр (см. shot_director.arbitrate_hook_candidates) ---
# on (ДЕФОЛТ) / off — реальное vision-суждение Gemini поверх уже готового
# шорт-листа кандидатов ХУКА (только хук — свободный тариф Gemini не
# выдержал бы арбитраж на весь эпизод), заменяет embedding-скоринг реальным
# пониманием фразы+картинки. В отличие от SHOT_DIRECTOR_MODE выше, живой
# вызов здесь УЖЕ подтверждён на реальном ключе (29 августа, см. CLAUDE.md
# ЧАСТЬ 14) — поэтому дефолт "on", а не "off".
# ЦЕНА: при непустом GEMINI_API_KEY каждый рендер тратит вызовы Gemini на
# хук-слоты. Счётчик — общий с SHOT_DIRECTOR_MODE
# (SHOT_DIRECTOR_MAX_CALLS_PER_RUN выше, один бюджет ключа/модели, free-tier
# по факту ~20/день). Без ключа/при исчерпанном лимите — fail-open, слот
# остаётся на уже вычисленном победителе, рендер не страдает.
# Дефолт живёт в scripts/feature_flags.py (единый реестр), эта строка —
# только явное значение для твоего .env.
VLM_ARBITER_MODE=on
# --- Рендер: гейты и грейд (значения ниже = дефолты, строки для явного отката) ---
# 1 (дефолт) — если хоть один клип не принят верификацией, final.mp4 не
# собирается вообще. 0 — старое поведение "собрать что есть".
RENDER_STRICT_GATE=1
# 1 (дефолт) — деффликер стокового ВИДЕО перед творческим грейдом. 0 —
# быстрый откат без редеплоя, если визуальный QC (Шаг 7.5) что-то не устроит.
# Историческое имя DEFLICKER продолжает работать, но документированное —
# это (до 03.09 код читал ТОЛЬКО DEFLICKER, и откат по документации молча
# не срабатывал).
DEFLICKER_ENABLED=1
# --- Speech Director, Шаг 3.5 (опц., см. scripts/speech_planner.py) ---
# 0 (дефолт) / 1 — подсказки по ударению известных омографов («мука́»/«му́ка»)
# в media_plan/speech_plan_annotated.txt. Чисто информационная строка для
# ручной сверки ПЕРЕД TTS: не трогает script.txt, тайминг и резы. Требует
# опциональной зависимости ruaccent (pip install ruaccent) — без неё
# fail-open, подсказок просто нет.
STRESS_HINTS_ENABLED=0
# --- Скорость рендера и вес файла (см. GRAIN_BLEND_MODE/DELIVERY_PROFILE в pipeline_smart.py) ---
# Режим наложения зерна: softlight (дефолт, нативный blend, клип рендерится
# ~в 1.8 раза быстрее) / grainmerge (плоский вес) / expr (прежняя формула
# через интерпретатор выражений — самый медленный шаг всего рендера).
GRAIN_BLEND_MODE=softlight
# Сила зерна (0.10 — прежняя калибровка). Единственный рычаг размера файла
# помимо CRF: шум несжимаем, зерно даёт +50-60% к размеру. 0.05 — компромисс.
GRAIN_OPACITY=0.10
# Профиль финального прохода: youtube (дефолт — VBV-потолок 12 Мбит/с,
# предсказуемый худший случай <=5.4 ГБ/час) / archive (без потолка, как
# раньше) / hevc (H.265, на 35-45% меньше, медленнее, нужен кодек для
# просмотра на Windows). DELIVERY_MAXRATE=8 переопределяет потолок (0 = без).
DELIVERY_PROFILE=youtube
DELIVERY_MAXRATE=
