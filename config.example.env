# Скопируйте в .env и впишите свои ключи. .env в git не попадает.

# --- Картинки: где рисовать (comfyui | openai | gateway) ---
IMAGE_BACKEND=comfyui
# comfyui: адрес и граф в API-формате с метками {{PROMPT}} {{SEED}} (assets/comfyui/README.md)
IMAGE_BASE_URL=http://127.0.0.1:8188
IMAGE_COMFY_WORKFLOW=assets/comfyui/qwen_image_template_api.json
# openai: IMAGE_BASE_URL локального OpenAI-совместимого сервера + IMAGE_MODEL (+ IMAGE_API_KEY при нужде)
# gateway: платная модель шлюза — IMAGE_MODEL и обязательный потолок IMAGE_MAX_SPEND
IMAGE_MODEL=
IMAGE_MAX_SPEND=
# Вариантов на кадр и раундов (раунд — если ни один вариант не прошёл проверку)
IMAGE_VARIANTS=3
IMAGE_ROUNDS=2
IMAGE_WORKERS=1
IMAGE_TIMEOUT_SEC=1800

# --- Шлюз моделей: планировщик, паспорт мира, судья, чтение подписей ---
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://anymodel.org/v1
PLANNER_MODEL=ds/deepseek-v4-flash
PLANNER_MAX_SPEND=200000
SHOT_JUDGE=1
SHOT_JUDGE_MODEL=qwen/qwen3.7-plus
SHOT_JUDGE_MAX_SPEND=300000

# --- Озвучка (Lumean, основной путь; иначе положите audio.mp3 сами) ---
LUMEAN_API_KEY=
LUMEAN_TEMPLATE_ID=

# --- Рендер ---
# Тёмный киношный грейд старого генератора: 0 — выключен (рисованный кадр на белом), 1 — включён
FILM_LOOK=0
# RENDER_WORKERS=3
