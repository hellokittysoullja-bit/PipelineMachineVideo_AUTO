# Скопируйте в .env и впишите свои ключи. .env в git не попадает.

# --- Шлюз моделей (планировщик кадров, картинки, проверка подписей) ---
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://anymodel.org/v1

# Модель картинок, которая пишет кириллицу (сильная, платная).
# Посмотреть модели и цены: python scripts/list_models.py image
IMAGE_MODEL=
# Потолок трат на картинки за один прогон (токены баланса шлюза). Обязателен для платной модели.
IMAGE_MAX_SPEND=
# Попыток на кадр, если подпись вышла с ошибкой в буквах.
IMAGE_MAX_ATTEMPTS=2
IMAGE_WORKERS=3

# Модель со зрением, которая читает текст на картинке (проверка подписей).
# Пусто — проверки нет, подписи сверяйте глазами.
TEXT_CHECK_MODEL=qwen/qwen3.7-plus

# Планировщик кадров (текстовая модель).
PLANNER_MODEL=ds/deepseek-v4-flash
PLANNER_MAX_SPEND=200000

# --- Озвучка (Lumean, основной путь) ---
LUMEAN_API_KEY=
LUMEAN_TEMPLATE_ID=
